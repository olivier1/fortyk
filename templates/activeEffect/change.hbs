<li data-index="{{index}}">
    {{#if changeType}}
    <div class="key grid-column-span4">
         <input type="text" name="system.changes.{{index}}.key" value="{{this.key}}">
      
    </div>
    <div class="type grid-column-span2">
         <select name="system.changes.{{index}}.type">
                {{selectOptions changeTypes selected=this.type}}
            </select>
    </div>
    <div class="value grid-column-span2">
       <input type="text" name="system.changes.{{index}}.value" value="{{this.value}}">
    </div>
        <!-- Your custom Phase Selection Dropdown -->
        <div class="form-group select-phase grid-column-span2">
            <select name="system.changes.{{index}}.phase">
                {{selectOptions effectPhases selected=this.phase}}
            </select>
        </div>

    {{else}}
    <div class="unregistered notification warning">
        {{localize "EFFECT.CHANGES.Unregistered" type=change.type}}
    </div>
    {{/if}}

    <div class="priority">
        <input type="number" name="system.changes.{{index}}.priority" value="{{this.priority}}">
    </div>
    <div class="controls">
        <button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteChange"></button>
    </div>
</li>
